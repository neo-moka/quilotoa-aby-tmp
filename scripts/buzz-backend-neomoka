#!/usr/bin/env python3
"""Backend provider: despliega agentes del Desktop al develop server de Neomoka.

Implementa el protocolo v1 de buzz-backend-* (ver
desktop/src-tauri/src/managed_agents/backend.rs): un JSON por stdin, un JSON
por stdout, un op por invocación.

  {"op": "info", ...}    → capacidades + config_schema (pinta el formulario
                           de "Where to run" en el diálogo de agente).
  {"op": "deploy", "agent": {...}, "provider_config": {...}}
                         → aprovisiona el agente como unidad systemd
                           `buzz-agent-<slug>` en el servidor por SSH y
                           devuelve {"agent_id": "<slug>"}.

Instalación (el Desktop escanea PATH y ~/.local/bin):

    ln -sf "$(git rev-parse --show-toplevel)/scripts/buzz-backend-neomoka" \
        ~/.local/bin/buzz-backend-neomoka

El deploy es idempotente: re-desplegar reescribe agent.env + unit y reinicia.
El Desktop ya es dueño de la identidad (nsec, auth tag, kind:0, 30177, alta en
canales); este script cubre solo la mitad runtime: usuario Unix, agent.env,
unit systemd, wrapper de credenciales para hermes, y arranque.

Errores: se reportan como {"ok": false, "error": "..."} con exit 0 — el
Desktop redacta secretos del mensaje antes de mostrarlo.
"""

import base64
import json
import os
import re
import shlex
import subprocess
import sys

VERSION = "0.4.0"

# Catálogo de MCPs gestionables por agente vía la env var NEOMOKA_MCP (lista
# separada por comas, p. ej. "dropi"; se define en Environment variables —
# global en "Set agent defaults" o por agente — y aplica en el siguiente
# Start/redeploy). Cada entrada declara el grupo Unix que da acceso a sus
# credenciales compartidas en el server y el comando stdio de su wrapper.
# Si la var está PRESENTE, el set se aplica exactamente (lo no listado se
# desactiva); si está AUSENTE, el server no se toca (compatibilidad).
#
# Alta de un MCP nuevo: aprovisionar en el server (wrapper en
# /opt/buzz-agents/bin/<n>-mcp, token 0640 root:mcp<n> en
# /opt/buzz-agents/mcp/, groupadd mcp<n>) y añadir su entrada aquí — el
# deploy inserta el bloque en el config.yaml de agentes que no lo tengan.
KNOWN_MCPS = {
    "dropi": {"group": "mcpdropi", "command": "/opt/buzz-agents/bin/dropi-mcp"},
}
DEFAULT_HOST = "root@134.122.118.128"
DEFAULT_IDENTITY = "~/workspace_skerna/.ssh/id_ed25519_moka_dev_ci"
SSH_CONNECT_TIMEOUT = 15
DEPLOY_TIMEOUT = 540  # el Desktop corta en 600s; dejamos margen para reportar

INFO_RESPONSE = {
    "ok": True,
    "name": "Neomoka develop server",
    "version": VERSION,
    "protocol_version": 1,
    "description": (
        "Aprovisiona el agente como unidad systemd en el develop server de "
        "Neomoka por SSH (usuario Unix + agent.env + buzz-acp)."
    ),
    "config_schema": {
        "type": "object",
        "required": ["host"],
        "properties": {
            "host": {
                "type": "string",
                "title": "Servidor",
                "description": "Destino SSH (usuario@host)",
                "default": DEFAULT_HOST,
            },
            "identity_file": {
                "type": "string",
                "title": "Identidad SSH",
                "description": "Ruta local de la identidad SSH con acceso root",
                "default": DEFAULT_IDENTITY,
            },
            "dry_run": {
                "type": "boolean",
                "title": "Dry run",
                "description": "true = imprime el plan en stderr sin tocar el servidor",
            },
        },
    },
}


def fail(message: str) -> None:
    print(json.dumps({"ok": False, "error": message}))
    sys.exit(0)


def slugify(name: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
    if not slug or not re.match(r"^[a-z0-9]", slug):
        raise ValueError(f"nombre de agente no derivable a slug: {name!r}")
    return slug[:32]


def env_file_lines(env: dict) -> str:
    """Serializa a formato EnvironmentFile de systemd (sin expansión de shell).

    systemd no interpreta comillas dobles como shell, pero sí permite valores
    entre comillas con escapes; los saltos de línea reales no son representables
    de forma portable, así que se rechazan (un system prompt multilínea debe
    viajar por BUZZ_ACP_SYSTEM_PROMPT_FILE, no inline).
    """
    lines = []
    for key, value in sorted(env.items()):
        if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", key):
            raise ValueError(f"nombre de variable inválido: {key!r}")
        value = "" if value is None else str(value)
        if "\n" in value or "\r" in value:
            raise ValueError(
                f"{key} contiene saltos de línea; usar la variante *_FILE"
            )
        escaped = value.replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'{key}="{escaped}"')
    return "\n".join(lines) + "\n"


def compose_agent_env(agent: dict) -> dict:
    """agent.env = policy_env (base) ← launch.env (autoritativo) ← credenciales.

    El orden replica el spawn local: policy primero, el entorno de seis capas
    del descriptor encima, y al final las claves que son del provider (creds,
    comando del agente, respond_to, timeouts) que nada debe pisar.
    """
    launch = agent.get("launch") or {}
    env: dict = {}
    env.update(launch.get("policy_env") or {})
    env.update(launch.get("env") or {})

    command = launch.get("command") or agent.get("agent_command")
    if not command:
        raise ValueError("payload sin launch.command ni agent_command")
    args = launch.get("args")
    if args is None:
        args = agent.get("agent_args") or []
    for required, key in [
        (agent.get("relay_url"), "BUZZ_RELAY_URL"),
        (agent.get("private_key_nsec"), "BUZZ_PRIVATE_KEY"),
    ]:
        if not required:
            raise ValueError(f"payload sin {key.lower()}")
        env[key] = required
    auth_tag = agent.get("auth_tag")
    if auth_tag:
        # El record lo guarda como string JSON; si llegara estructurado, se
        # re-serializa para que el env quede con JSON válido y no repr().
        env["BUZZ_AUTH_TAG"] = (
            auth_tag if isinstance(auth_tag, str) else json.dumps(auth_tag)
        )
    env["BUZZ_ACP_AGENT_COMMAND"] = command
    # Verbatim como el spawn local (runtime.rs: agent_args.join(",")): una
    # lista vacía produce "", y normalize_agent_args del harness filtra los
    # args vacíos. Forzar "acp" aquí rompería wrappers como hermes-acp, que
    # ya llevan el subcomando adentro ("acp acp").
    env["BUZZ_ACP_AGENT_ARGS"] = ",".join(str(a) for a in args)
    if agent.get("respond_to"):
        env["BUZZ_ACP_RESPOND_TO"] = agent["respond_to"]
    if agent.get("respond_to_allowlist"):
        env["BUZZ_ACP_RESPOND_TO_ALLOWLIST"] = ",".join(
            agent["respond_to_allowlist"]
        )
    for field, key in [
        ("idle_timeout_seconds", "BUZZ_ACP_IDLE_TIMEOUT"),
        ("max_turn_duration_seconds", "BUZZ_ACP_MAX_TURN_DURATION"),
        ("turn_timeout_seconds", "BUZZ_ACP_TURN_TIMEOUT"),
    ]:
        if agent.get(field) is not None:
            env[key] = str(agent[field])
    return env


def divert_multiline(env: dict, slug: str) -> tuple:
    """Mueve los valores multilínea con variante *_FILE a archivos sidecar.

    Los system prompts reales son multilínea y EnvironmentFile de systemd no
    representa saltos de línea; buzz-acp ofrece BUZZ_ACP_SYSTEM_PROMPT_FILE y
    BUZZ_ACP_HEARTBEAT_PROMPT_FILE justo para esto. Cualquier otra variable
    multilínea sigue siendo un error explícito en env_file_lines.
    """
    diversions = [
        ("BUZZ_ACP_SYSTEM_PROMPT", "BUZZ_ACP_SYSTEM_PROMPT_FILE", "system-prompt.md"),
        (
            "BUZZ_ACP_HEARTBEAT_PROMPT",
            "BUZZ_ACP_HEARTBEAT_PROMPT_FILE",
            "heartbeat-prompt.md",
        ),
    ]
    files = {}
    for inline_key, file_key, filename in diversions:
        value = env.get(inline_key)
        if isinstance(value, str) and ("\n" in value or "\r" in value):
            files[filename] = value
            env = dict(env)
            del env[inline_key]
            env[file_key] = f"/home/dropshipping/{slug}/{filename}"
    return env, files


MCP_DEF_PREFIX = "NEOMOKA_MCP_DEF_"


def extract_mcp_defs(env: dict) -> tuple:
    """Separa las definiciones de conexión (NEOMOKA_MCP_DEF_*) del env.

    Devuelve (env sin las defs, registro dinámico). Las defs vienen de la
    sección global del Desktop como JSON {"name", "url"?, "auth"?, "command"?};
    se materializan en el server (grupo + token + wrapper) y NUNCA se
    persisten en el agent.env del agente. El registro resultante extiende
    KNOWN_MCPS sin permitir que una def pise un built-in.
    """
    clean = dict(env)
    registry = dict(KNOWN_MCPS)
    for key in sorted(env):
        if not key.startswith(MCP_DEF_PREFIX):
            continue
        raw = clean.pop(key)
        try:
            def_ = json.loads(raw)
        except (TypeError, ValueError):
            print(f"{key}: JSON inválido, ignorado", file=sys.stderr)
            continue
        name = def_.get("name") if isinstance(def_, dict) else None
        if not isinstance(name, str) or not re.match(r"^[a-z][a-z0-9-]{0,23}$", name):
            print(f"{key}: def sin nombre válido, ignorada", file=sys.stderr)
            continue
        if name in KNOWN_MCPS:
            continue  # los built-ins ya están aprovisionados a mano
        url = def_.get("url") if isinstance(def_.get("url"), str) else None
        command = def_.get("command") if isinstance(def_.get("command"), str) else None
        if bool(url) == bool(command):
            print(f"{key}: necesita exactamente url o command, ignorada", file=sys.stderr)
            continue
        registry[name] = {
            "group": "mcp" + name.replace("-", ""),
            "command": f"/opt/buzz-agents/bin/{name}-mcp",
            "def": {"url": url, "auth": def_.get("auth"), "command": command},
        }
    return clean, registry


def mcp_provisioning_block(registry: dict, wanted: set) -> str:
    """Bash que materializa en el server las conexiones definidas y pedidas.

    Solo se aprovisionan las defs que este agente usa (grupo, token 0640
    root:grupo cuando hay auth, y wrapper stdio 0755). Idempotente: cada
    deploy reescribe wrapper y token, así una rotación de credencial llega
    con el siguiente Start.
    """
    lines = []
    for name, spec in sorted(registry.items()):
        def_ = spec.get("def")
        if def_ is None or name not in wanted:
            continue
        group = spec["group"]
        wrapper = spec["command"]
        token_path = f"/opt/buzz-agents/mcp/{name}-mcp-token"
        if def_["url"]:
            if def_.get("auth"):
                exec_line = (
                    f"exec /usr/bin/mcp-remote {shlex.quote(def_['url'])} "
                    f'--header "Authorization: Bearer $(cat {token_path})"'
                )
            else:
                exec_line = f"exec /usr/bin/mcp-remote {shlex.quote(def_['url'])}"
        else:
            exec_line = f"exec {def_['command']}"
        wrapper_b64 = base64.b64encode(
            f"#!/bin/sh\n# Generado por buzz-backend-neomoka (NEOMOKA_MCP_DEF).\n{exec_line}\n".encode()
        ).decode()
        lines.append(f"\n# --- conexión MCP '{name}' ---")
        lines.append(f"getent group {group} >/dev/null || groupadd {group}")
        if def_["url"] and def_.get("auth"):
            auth_b64 = base64.b64encode(str(def_["auth"]).encode()).decode()
            lines.append("install -d -m 0755 /opt/buzz-agents/mcp")
            lines.append(
                f"printf '%s' {shlex.quote(auth_b64)} | base64 -d > {token_path}"
            )
            lines.append(f"chown root:{group} {token_path}")
            lines.append(f"chmod 0640 {token_path}")
        lines.append(
            f"printf '%s' {shlex.quote(wrapper_b64)} | base64 -d > {wrapper}"
        )
        lines.append(f"chmod 0755 {wrapper}")
    return "\n".join(lines) + ("\n" if lines else "")


def mcp_management_block(slug: str, env: dict, registry: dict) -> str:
    """Bloque bash que aplica NEOMOKA_MCP: grupos Unix + enabled en config.yaml.

    Solo se emite cuando la variable viene en el env del agente. El set se
    aplica exacto sobre el registro (built-ins + defs del catálogo): lo
    listado se habilita (grupo + enabled true) y lo conocido no listado se
    deshabilita (fuera del grupo + enabled false). El config.yaml solo se
    toca si existe (agentes hermes); en su ausencia el grupo sigue siendo el
    interruptor real (el wrapper no puede leer el token).
    """
    raw = env.get("NEOMOKA_MCP")
    if raw is None:
        return ""
    wanted = {name.strip() for name in str(raw).split(",") if name.strip()}
    for name in sorted(wanted - set(registry)):
        print(f"NEOMOKA_MCP: mcp desconocido {name!r}, ignorado", file=sys.stderr)
    q_slug = shlex.quote(slug)
    lines = ["\n# --- MCP por agente (NEOMOKA_MCP) ---"]
    lines.append(mcp_provisioning_block(registry, wanted))
    for name, spec in registry.items():
        group = spec["group"]
        if name in wanted:
            lines.append(
                f"getent group {group} >/dev/null && usermod -aG {group} {q_slug}"
            )
        else:
            lines.append(f"gpasswd -d {q_slug} {group} >/dev/null 2>&1 || true")
        enabled = "true" if name in wanted else "false"
        command = spec["command"]
        # Toggle si el bloque existe; si falta y el MCP está pedido, inserta el
        # bloque (bajo mcp_servers:, creando la sección si tampoco existe) —
        # así un MCP dado de alta después de crear al agente también le llega.
        lines.append(
            f"""python3 - <<'PYMCP'
import re
path = "/home/{slug}/.hermes/config.yaml"
try:
    text = open(path).read()
except FileNotFoundError:
    raise SystemExit(0)
pattern = re.compile(r"(  {name}:\\n    command: [^\\n]*\\n    enabled: )(true|false)")
updated, hits = pattern.subn(lambda m: m.group(1) + "{enabled}", text, count=1)
if hits == 0 and "{enabled}" == "true":
    block = "  {name}:\\n    command: {command}\\n    enabled: true\\n"
    if re.search(r"^mcp_servers:", updated, re.M):
        updated = re.sub(r"^mcp_servers:\\n", "mcp_servers:\\n" + block, updated, count=1, flags=re.M)
    else:
        updated = updated.rstrip("\\n") + "\\n\\nmcp_servers:\\n" + block
if updated != text:
    open(path, "w").write(updated)
PYMCP"""
        )
    return "\n".join(lines) + "\n"


def remote_script(slug: str, display_name: str, env: dict) -> str:
    """Script bash que corre en el servidor. Los secretos viajan por stdin del
    ssh (nunca argv) y aterrizan solo en archivos 0600/0400."""
    env, registry = extract_mcp_defs(env)
    env, sidecar_files = divert_multiline(env, slug)
    env_b64 = base64.b64encode(env_file_lines(env).encode()).decode()
    sidecar_block = ""
    for filename, content in sorted(sidecar_files.items()):
        content_b64 = base64.b64encode(content.encode()).decode()
        sidecar_block += (
            f"printf '%s' {shlex.quote(content_b64)} | base64 -d "
            f"> /home/dropshipping/{shlex.quote(slug)}/{filename}\n"
            f"chmod 0600 /home/dropshipping/{shlex.quote(slug)}/{filename}\n"
        )
    agent_command = env["BUZZ_ACP_AGENT_COMMAND"]
    is_hermes = "hermes" in os.path.basename(agent_command)
    mcp_block = mcp_management_block(slug, env, registry)
    q_slug = shlex.quote(slug)
    # Va dentro de un heredoc sin comillas: solo texto plano inofensivo.
    safe_name = re.sub(r"[^A-Za-z0-9 ._-]", "", display_name).strip() or slug
    description = f"Buzz agent: {safe_name}"

    hermes_block = ""
    if is_hermes:
        # hermes despoja BUZZ_PRIVATE_KEY/RELAY_URL/AUTH_TAG del env de su
        # terminal (blocklist no configurable), así que el `buzz` que invoque
        # necesita un wrapper que las re-inyecte desde un archivo 0400.
        hermes_block = f"""
# --- runtime hermes: config de plantilla + wrapper de credenciales ---
if [ -d /root/.hermes ] && [ ! -d /home/{q_slug}/.hermes ]; then
  cp -a /root/.hermes /home/{q_slug}/.hermes
  chown -R {q_slug}:{q_slug} /home/{q_slug}/.hermes
fi
install -d -o {q_slug} -g {q_slug} -m 0700 /home/{q_slug}/.config/buzz /home/{q_slug}/bin
grep -E '^(BUZZ_PRIVATE_KEY|BUZZ_RELAY_URL|BUZZ_AUTH_TAG)=' \\
  /home/dropshipping/{q_slug}/agent.env > /home/{q_slug}/.config/buzz/credentials.env
chown {q_slug}:{q_slug} /home/{q_slug}/.config/buzz/credentials.env
chmod 0400 /home/{q_slug}/.config/buzz/credentials.env
cat > /home/{q_slug}/bin/buzz <<'WRAP'
#!/bin/bash
set -a
. "$HOME/.config/buzz/credentials.env"
set +a
exec /opt/buzz-agents/bin/buzz "$@"
WRAP
chown {q_slug}:{q_slug} /home/{q_slug}/bin/buzz
chmod 0755 /home/{q_slug}/bin/buzz
"""

    return f"""set -euo pipefail

# --- usuario Unix + workspace compartido ---
getent group buzzagents >/dev/null || groupadd buzzagents
id -u {q_slug} >/dev/null 2>&1 || useradd -m -G buzzagents -s /bin/bash {q_slug}
install -d -o {q_slug} -g {q_slug} /home/{q_slug}/workspace
[ -d /srv/buzz-shared ] && ln -sfn /srv/buzz-shared /home/{q_slug}/workspace/SHARED

# --- agent.env (0600 root, layout estándar del server) ---
install -d -m 0750 /home/dropshipping/{q_slug}
umask 077
printf '%s' {shlex.quote(env_b64)} | base64 -d > /home/dropshipping/{q_slug}/agent.env
chmod 0600 /home/dropshipping/{q_slug}/agent.env
{sidecar_block}
{hermes_block}
{mcp_block}
# --- unit systemd ---
cat > /etc/systemd/system/buzz-agent-{q_slug}.service <<UNIT
[Unit]
Description={description}
After=network-online.target
Wants=network-online.target

[Service]
User={q_slug}
Group={q_slug}
WorkingDirectory=/home/{q_slug}/workspace
EnvironmentFile=/home/dropshipping/{q_slug}/agent.env
ExecStart=/opt/buzz-agents/bin/buzz-acp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable buzz-agent-{q_slug} >/dev/null 2>&1 || true
systemctl restart buzz-agent-{q_slug}
sleep 2
state=$(systemctl is-active buzz-agent-{q_slug} || true)
echo "buzz-agent-{q_slug}: $state" >&2
[ "$state" = active ]
"""


def op_deploy(request: dict) -> dict:
    agent = request.get("agent")
    if not isinstance(agent, dict):
        raise ValueError("request sin objeto agent")
    config = request.get("provider_config") or {}

    slug = slugify(str(agent.get("name") or ""))
    env = compose_agent_env(agent)
    script = remote_script(slug, str(agent.get("name")), env)

    host = str(config.get("host") or DEFAULT_HOST)
    identity = os.path.expanduser(str(config.get("identity_file") or DEFAULT_IDENTITY))
    dry_run = config.get("dry_run") in (True, "true")

    if dry_run:
        print("--- dry run: script que se ejecutaría por SSH ---", file=sys.stderr)
        print(script, file=sys.stderr)
        return {"ok": True, "agent_id": slug, "dry_run": True}

    ssh_cmd = [
        "ssh",
        "-i", identity,
        "-o", "BatchMode=yes",
        "-o", f"ConnectTimeout={SSH_CONNECT_TIMEOUT}",
        "-o", "StrictHostKeyChecking=accept-new",
        host,
        "bash -s",
    ]
    proc = subprocess.run(
        ssh_cmd,
        input=script.encode(),
        capture_output=True,
        timeout=DEPLOY_TIMEOUT,
    )
    stderr_tail = proc.stderr.decode(errors="replace")[-2000:]
    if stderr_tail:
        print(stderr_tail, file=sys.stderr)
    if proc.returncode != 0:
        raise RuntimeError(
            f"ssh/aprovisionamiento falló (exit {proc.returncode}): {stderr_tail.strip()[-500:]}"
        )
    return {"ok": True, "agent_id": slug}


def main() -> None:
    try:
        request = json.loads(sys.stdin.read())
    except (ValueError, OSError) as error:
        fail(f"request inválido: {error}")
        return

    op = request.get("op")
    try:
        if op == "info":
            print(json.dumps(INFO_RESPONSE))
        elif op == "deploy":
            print(json.dumps(op_deploy(request)))
        else:
            fail(f"op no soportado: {op!r}")
    except subprocess.TimeoutExpired:
        fail(f"el aprovisionamiento excedió {DEPLOY_TIMEOUT}s")
    except (ValueError, RuntimeError, OSError) as error:
        fail(str(error))


if __name__ == "__main__":
    main()
